---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

const projectTypes = ["Design Systems", "Product Design", "Advisory / Audit", "Other"];
const inputClass =
  "w-full bg-surface-container px-4 py-3 rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline/60 focus:outline-none focus:ring-0 focus:bg-surface-container-high transition-all shadow-inner border border-transparent focus:border-outline-variant/40";
---

<Base title={`Contact — ${site.name}`} active="contact">
  <div class="relative w-full overflow-hidden bg-surface-container-lowest">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[840px] h-[340px] bg-primary/5 rounded-full blur-[140px] pointer-events-none"></div>
    <section class="relative max-w-[1240px] mx-auto w-full px-margin md:px-margin-tablet lg:px-margin-desktop py-space-2xl md:py-24">
      <div class="max-w-3xl mb-space-2xl">
        <h1 class="font-display text-display-mobile md:text-headline-lg lg:text-display text-on-surface tracking-tight mb-space-sm">Let’s talk.</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
          Open to UI and product design roles, design systems work, and collaborations.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl lg:gap-space-2xl items-start">
        <!-- Form -->
        <div class="lg:col-span-7 flex flex-col">
          <div class="bg-surface-container-low p-space-lg md:p-space-xl rounded-xl shadow-xl border border-outline-variant/10">
            <form class="flex flex-col gap-space-lg" id="contact-form" data-endpoint={site.formEndpoint} data-email={site.email}>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
                <div class="flex flex-col gap-2">
                  <label class="font-label-caps text-label-caps uppercase text-on-surface-variant flex items-center justify-between" for="name">
                    <span>Name</span><span class="text-primary text-[10px]" aria-hidden="true">*</span>
                  </label>
                  <input class={inputClass} id="name" name="name" autocomplete="name" placeholder="Your name" required type="text" />
                </div>
                <div class="flex flex-col gap-2">
                  <label class="font-label-caps text-label-caps uppercase text-on-surface-variant flex items-center justify-between" for="email">
                    <span>Email</span><span class="text-primary text-[10px]" aria-hidden="true">*</span>
                  </label>
                  <input class={inputClass} id="email" name="email" autocomplete="email" placeholder="you@example.com" required type="email" />
                </div>
              </div>

              <fieldset class="flex flex-col gap-2.5">
                <legend class="font-label-caps text-label-caps uppercase text-on-surface-variant mb-2.5">Project Type</legend>
                <div class="flex flex-wrap gap-2">
                  {
                    projectTypes.map((t, i) => (
                      <label class="cursor-pointer">
                        <input type="radio" name="projectType" value={t} class="peer sr-only" checked={i === 1} />
                        <span class="inline-block px-4 py-2 rounded-full font-label-caps text-label-caps uppercase tracking-wider bg-surface-container text-on-surface-variant hover:text-on-surface hover:bg-surface-container-high transition-all shadow-sm peer-checked:bg-primary-container/20 peer-checked:text-primary peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-primary">
                          {t}
                        </span>
                      </label>
                    ))
                  }
                </div>
              </fieldset>

              <div class="flex flex-col gap-2">
                <label class="font-label-caps text-label-caps uppercase text-on-surface-variant flex items-center justify-between" for="message">
                  <span>Message</span><span class="text-primary text-[10px]" aria-hidden="true">*</span>
                </label>
                <textarea class:list={[inputClass, "resize-none py-3.5"]} id="message" name="message" placeholder="Tell me a bit about your project, timeline, and goals..." required rows="5"></textarea>
              </div>

              <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-space-md pt-1">
                <span class="font-code-sm text-code-sm text-outline">Typically responds within 24 hours.</span>
                <button class="group inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full font-label-md text-label-md font-semibold bg-primary text-on-primary hover:bg-secondary transition-all hover:-translate-y-0.5 shadow-lg shrink-0 disabled:opacity-50 disabled:cursor-not-allowed" id="submit-btn" type="submit">
                  <span>Send Message</span>
                  <span class="material-symbols-outlined text-lg transition-transform group-hover:translate-x-1">arrow_forward</span>
                </button>
              </div>

              <div class="hidden p-4 rounded-lg bg-surface-container-high items-center gap-3" id="form-feedback" role="status">
                <span class="material-symbols-outlined text-primary" id="feedback-icon">check_circle</span>
                <p class="font-body-sm text-body-sm text-on-surface" id="feedback-text"></p>
              </div>
            </form>
          </div>
        </div>

        <!-- Direct channels -->
        <div class="lg:col-span-5 flex flex-col gap-space-lg">
          <div class="bg-surface-container-low p-space-lg rounded-xl shadow-xl border border-outline-variant/10">
            <span class="font-label-caps text-label-caps uppercase text-outline block mb-2">Direct Email</span>
            <a class="font-headline-sm text-headline-sm text-on-surface hover:text-primary transition-colors tracking-tight block break-all mb-4" href={`mailto:${site.email}`}>{site.email}</a>
            <button class="inline-flex items-center gap-2 px-4 py-2 rounded-full font-label-caps text-label-caps uppercase text-on-surface bg-surface-container hover:bg-surface-container-high transition-all" id="copy-btn" data-email={site.email} type="button">
              <span class="material-symbols-outlined text-sm" id="copy-icon">content_copy</span>
              <span id="copy-text">Copy Email</span>
            </button>
          </div>

          <div class="bg-surface-container-low p-space-lg rounded-xl shadow-xl border border-outline-variant/10 flex items-center justify-between gap-4">
            <div class="flex flex-col gap-1">
              <span class="font-label-caps text-label-caps uppercase text-outline">Location</span>
              <span class="font-title-md text-title-md text-on-surface">{site.location}</span>
            </div>
            <span class="font-code-sm text-code-sm text-primary px-3 py-1.5 rounded-full bg-primary/10 shrink-0">{site.timezoneLabel}</span>
          </div>

          <div class="bg-surface-container-low p-space-lg rounded-xl shadow-xl border border-outline-variant/10 flex flex-col gap-space-sm">
            <span class="font-label-caps text-label-caps uppercase text-outline mb-1">On the Web</span>
            <div class="flex flex-wrap gap-x-6 gap-y-3 pt-1">
              {
                site.socials.map((s) => (
                  <a class="inline-flex items-center gap-1 font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors group" href={s.href} target="_blank" rel="noopener">
                    <span>{s.label}</span>
                    <span class="material-symbols-outlined text-sm text-outline group-hover:text-primary transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">arrow_outward</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement | null;
  copyBtn?.addEventListener("click", async () => {
    const text = document.getElementById("copy-text")!;
    const icon = document.getElementById("copy-icon")!;
    try {
      await navigator.clipboard.writeText(copyBtn.dataset.email ?? "");
      text.textContent = "Copied!";
      icon.textContent = "check";
    } catch {
      text.textContent = "Copy failed";
    }
    setTimeout(() => {
      text.textContent = "Copy Email";
      icon.textContent = "content_copy";
    }, 2500);
  });

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const feedback = document.getElementById("form-feedback")!;
  const feedbackText = document.getElementById("feedback-text")!;
  const feedbackIcon = document.getElementById("feedback-icon")!;

  function show(ok: boolean, message: string) {
    feedback.classList.remove("hidden");
    feedback.classList.add("flex");
    feedbackIcon.textContent = ok ? "check_circle" : "error";
    feedbackIcon.classList.toggle("text-primary", ok);
    feedbackIcon.classList.toggle("text-error", !ok);
    feedbackText.textContent = message;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const endpoint = form.dataset.endpoint;

    // No form service configured: open the visitor's email app instead.
    if (!endpoint) {
      const subject = `[${data.get("projectType")}] Inquiry from ${data.get("name")}`;
      const body = `${data.get("message")}\n\n— ${data.get("name")} (${data.get("email")})`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      show(true, "Opening your email app to send the message.");
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    try {
      const res = await fetch(endpoint, { method: "POST", body: data, headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      show(true, "Thank you! Your message has been sent. I’ll get back to you shortly.");
    } catch {
      show(false, `Something went wrong. Please email ${form.dataset.email} directly.`);
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
