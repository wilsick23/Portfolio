---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { about } from "../data/about";
import { toneText, toneBg } from "../data/tones";
import type { Tone } from "../data/types";
---

<Base title={`About — ${site.name}`} active="about">
  <!-- Intro -->
  <section class="relative w-full pt-16 md:pt-24 pb-20 md:pb-28 bg-surface-container-lowest">
    <div class="max-w-[1240px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-5">
          <div class="relative max-w-xs mx-auto lg:max-w-sm">
            <div class="relative overflow-hidden rounded-2xl bg-surface-container ring-1 ring-outline-variant/30 shadow-2xl">
              <img alt={site.name} class="w-full aspect-[4/5] object-cover object-center grayscale contrast-[1.05] brightness-95" src={site.portrait} />
              <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-4 left-5 right-5 flex items-center justify-between text-xs font-code-sm text-on-surface-variant">
                <span>{site.name}</span>
                <span class="text-primary font-medium">{site.location}</span>
              </div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-7 flex flex-col justify-center">
          <div class="flex items-center gap-2 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
            <span class="font-label-caps text-label-caps uppercase text-primary tracking-widest">{about.eyebrow}</span>
          </div>
          <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg lg:text-[3.25rem] text-on-surface tracking-tight leading-[1.12] mb-8 font-semibold">
            {about.headline}
          </h1>
          <div class="flex flex-col gap-5 text-on-surface-variant font-body-lg text-body-lg leading-relaxed">
            {about.bio.map((p) => <p>{p}</p>)}
          </div>
          <dl class="flex flex-wrap items-center gap-x-6 gap-y-4 mt-10 pt-8 border-t border-outline-variant/20">
            {
              about.stats.map((s, i) => (
                <>
                  {i > 0 && <div class="hidden sm:block w-px h-8 bg-outline-variant/30" aria-hidden="true" />}
                  <div>
                    <dt class="block font-code-sm text-code-sm text-on-surface-variant uppercase tracking-wider">{s.label}</dt>
                    <dd class="font-title-md text-title-md text-on-surface font-semibold mt-0.5 block">{s.value}</dd>
                  </div>
                </>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="w-full py-20 border-t border-outline-variant/20 bg-surface-container-low/40">
    <div class="max-w-[1240px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <div class="flex items-center gap-2 mb-3">
            <span class="font-code-sm text-code-sm text-secondary">01</span>
            <span class="text-outline-variant">/</span>
            <span class="font-label-caps text-label-caps uppercase text-secondary tracking-widest">Trajectory</span>
          </div>
          <h2 class="font-headline-md text-headline-md text-on-surface font-semibold">Experience</h2>
          <p class="font-body-sm text-body-sm text-on-surface-variant mt-3 max-w-xs leading-relaxed">{about.experienceIntro}</p>
        </div>
        <div class="lg:col-span-8 flex flex-col divide-y divide-outline-variant/20">
          {
            about.experience.map((job) => (
              <div class="py-7 first:pt-0 last:pb-0 group">
                <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
                  <div class="flex flex-wrap items-center gap-x-3">
                    <h3 class="font-title-md text-title-md text-on-surface font-semibold group-hover:text-primary transition-colors">{job.company}</h3>
                    <span class="text-outline-variant" aria-hidden="true">•</span>
                    <span class="font-body-md text-body-md text-on-surface-variant">{job.role}</span>
                  </div>
                  <span class:list={["font-code-sm text-code-sm shrink-0", job.current ? "text-primary font-medium" : "text-on-surface-variant"]}>
                    {job.dates}
                  </span>
                </div>
                <p class="font-body-sm text-body-sm text-on-surface-variant/90 leading-relaxed max-w-2xl">{job.summary}</p>
              </div>
            ))
          }
          <div class="mt-10 p-7 rounded-2xl bg-surface-container/60 border border-outline-variant/20">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 mb-2">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-lg text-primary">school</span>
                <h3 class="font-title-md text-title-md text-on-surface font-semibold">{about.education.school}</h3>
              </div>
              <span class="font-code-sm text-code-sm text-on-surface-variant shrink-0">{about.education.dates}</span>
            </div>
            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">{about.education.degree}</p>
            <p class="font-code-sm text-code-sm text-outline mt-2">{about.education.extra}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section class="w-full py-20 border-t border-outline-variant/20 bg-surface-container-lowest">
    <div class="max-w-[1240px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-4">
        <div>
          <div class="flex items-center gap-2 mb-3">
            <span class="font-code-sm text-code-sm text-tertiary">02</span>
            <span class="text-outline-variant">/</span>
            <span class="font-label-caps text-label-caps uppercase text-tertiary tracking-widest">Capabilities</span>
          </div>
          <h2 class="font-headline-md text-headline-md text-on-surface font-semibold">Core Expertise</h2>
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant max-w-sm">{about.expertiseIntro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        {
          about.expertise.map((e) => (
            <div class="p-7 rounded-2xl bg-surface-container/60 border border-outline-variant/20 flex flex-col">
              <div class:list={["w-10 h-10 rounded-xl bg-surface-container-high flex items-center justify-center mb-6", toneText[e.tone as Tone]]}>
                <span class="material-symbols-outlined text-xl">{e.icon}</span>
              </div>
              <h3 class="font-title-md text-title-md text-on-surface font-semibold mb-3">{e.title}</h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed mb-6">{e.summary}</p>
              <ul class="flex flex-col gap-2.5 font-body-sm text-body-sm text-on-surface/90 border-t border-outline-variant/20 pt-5 mt-auto">
                {e.items.map((item) => (
                  <li class="flex items-center gap-2">
                    <span class:list={["w-1.5 h-1.5 rounded-full shrink-0", toneBg[e.tone as Tone]]} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="w-full py-24 border-t border-outline-variant/20 bg-surface-container-lowest">
    <div class="max-w-[1240px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop text-center">
      <div class="max-w-2xl mx-auto flex flex-col items-center">
        <span class="font-label-caps text-label-caps uppercase text-primary tracking-widest mb-4">{about.closing.eyebrow}</span>
        <h2 class="font-headline-lg text-headline-md md:text-headline-lg text-on-surface tracking-tight font-semibold">{about.closing.heading}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant mt-4 mb-8 max-w-lg leading-relaxed">{about.closing.body}</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a class="px-6 py-3 rounded-full font-label-caps text-label-caps uppercase tracking-wider bg-primary hover:bg-secondary text-on-primary font-semibold transition-all shadow-sm" href="/contact/">Initiate Dialogue</a>
          <a class="px-6 py-3 rounded-full font-label-caps text-label-caps uppercase tracking-wider bg-surface-container hover:bg-surface-container-high text-on-surface border border-outline-variant/30 transition-all" href="/#work">View Work</a>
        </div>
      </div>
    </div>
  </section>
</Base>
