---
import { site, nav } from "../data/site";

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<header class="fixed top-0 inset-x-0 z-50 bg-surface/80 backdrop-blur-xl border-b border-outline-variant/20">
  <div class="h-14 max-w-[1240px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop flex items-center justify-between gap-space-md">
    <div class="flex items-center gap-space-md shrink-0">
      <a class="font-title-md text-title-md text-on-surface tracking-tight hover:text-primary transition-colors" href="/">{site.name}</a>
    </div>

    <nav aria-label="Main" class="hidden lg:flex items-center gap-space-xs p-1 rounded-full bg-surface-container-low border border-outline-variant/20">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.key === active ? "page" : undefined}
            class:list={[
              "px-space-md py-space-xs rounded-full font-label-md text-label-md transition-colors",
              item.key === active
                ? "bg-surface-container text-on-surface"
                : "text-on-surface-variant hover:text-on-surface hover:bg-surface-container",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-space-sm sm:gap-space-md shrink-0">
      <a class="hidden sm:inline-flex items-center justify-center px-4 py-1.5 rounded-full font-label-caps text-label-caps uppercase tracking-wider text-on-surface bg-surface-container hover:bg-surface-container-high transition-all border border-outline-variant/30 hover:border-outline-variant/60" href={site.resumeUrl} target="_blank" rel="noopener">Resume / CV</a>
      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-9 h-9 rounded-full bg-surface-container border border-outline-variant/30 text-on-surface"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="material-symbols-outlined text-xl" id="menu-icon">menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden lg:hidden border-t border-outline-variant/20 bg-surface/95">
    <div class="max-w-[1240px] mx-auto px-margin md:px-margin-tablet py-space-md flex flex-col gap-1">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.key === active ? "page" : undefined}
            class:list={[
              "px-space-md py-3 rounded-xl font-label-md text-body-md transition-colors",
              item.key === active ? "bg-surface-container text-on-surface" : "text-on-surface-variant hover:text-on-surface",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a class="px-space-md py-3 rounded-xl font-label-md text-body-md text-on-surface-variant hover:text-on-surface" href={site.resumeUrl} target="_blank" rel="noopener">Resume / CV</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const icon = document.getElementById("menu-icon");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    menu?.classList.toggle("hidden", open);
    if (icon) icon.textContent = open ? "menu" : "close";
  });
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => toggle?.click()));
</script>
