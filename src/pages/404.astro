---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base title={`Page not found — ${site.name}`}>
  <section class="max-w-[1240px] mx-auto px-margin md:px-margin-tablet lg:px-margin-desktop py-32">
    <span class="font-label-caps text-label-caps uppercase text-primary tracking-widest">404</span>
    <h1 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface tracking-tight mt-4 mb-6">This page doesn’t exist.</h1>
    <a class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-on-surface text-surface font-medium text-sm hover:bg-primary transition-colors" href="/">Back home</a>
  </section>
</Base>
